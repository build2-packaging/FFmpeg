# ARM
#
# subsystems
libul{avcodec}: libavcodec/arm/c{ac3dsp_init_arm} \
                libavcodec/arm/S{ac3dsp_arm}: include = ($ARCH_ARM && $CONFIG_AC3DSP)

libul{avcodec}: libavcodec/arm/c{audiodsp_init_arm}: include = ($ARCH_ARM && $CONFIG_AUDIODSP)

libul{avcodec}: libavcodec/arm/c{blockdsp_init_arm}: include = ($ARCH_ARM && $CONFIG_BLOCKDSP)

libul{avcodec}: libavcodec/arm/c{fmtconvert_init_arm}: include = ($ARCH_ARM && $CONFIG_FMTCONVERT)

libul{avcodec}: libavcodec/arm/c{g722dsp_init_arm}: include = ($ARCH_ARM && $CONFIG_G722DSP)

libul{avcodec}: libavcodec/arm/c{h264chroma_init_arm}: include = ($ARCH_ARM && $CONFIG_H264CHROMA)

libul{avcodec}: libavcodec/arm/c{h264dsp_init_arm}: include = ($ARCH_ARM && $CONFIG_H264DSP)

libul{avcodec}: libavcodec/arm/c{h264pred_init_arm}: include = ($ARCH_ARM && $CONFIG_H264PRED)

libul{avcodec}: libavcodec/arm/c{h264qpel_init_arm}: include = ($ARCH_ARM && $CONFIG_H264QPEL)

libul{avcodec}: libavcodec/arm/c{hpeldsp_init_arm} \
                libavcodec/arm/S{hpeldsp_arm}: include = ($ARCH_ARM && $CONFIG_HPELDSP)

libul{avcodec}: libavcodec/arm/c{idctdsp_init_arm} \
                libavcodec/arm/S{idctdsp_arm        \
                                 jrevdct_arm         \
                                 simple_idct_arm}: include = ($ARCH_ARM && $CONFIG_IDCTDSP)

libul{avcodec}: libavcodec/arm/c{lossless_audiodsp_init_arm}: include = ($ARCH_ARM && $CONFIG_LLAUDDSP)

libul{avcodec}: libavcodec/arm/c{me_cmp_init_arm}: include = ($ARCH_ARM && $CONFIG_ME_CMP)

libul{avcodec}: libavcodec/arm/c{mpegaudiodsp_init_arm}: include = ($ARCH_ARM && $CONFIG_MPEGAUDIODSP)

libul{avcodec}: libavcodec/arm/c{mpegvideo_arm}: include = ($ARCH_ARM && $CONFIG_MPEGVIDEO)

libul{avcodec}: libavcodec/arm/c{mpegvideoencdsp_init_arm}: include = ($ARCH_ARM && $CONFIG_MPEGVIDEOENC)

libul{avcodec}: libavcodec/arm/c{neontest}: include = ($ARCH_ARM && $CONFIG_NEON_CLOBBER_TEST)

libul{avcodec}: libavcodec/arm/c{pixblockdsp_init_arm}: include = ($ARCH_ARM && $CONFIG_PIXBLOCKDSP)

libul{avcodec}: libavcodec/arm/c{rv34dsp_init_arm}: include = ($ARCH_ARM && $CONFIG_RV34DSP)

libul{avcodec}: libavcodec/arm/c{vc1dsp_init_arm}: include = ($ARCH_ARM && $CONFIG_VC1DSP)

libul{avcodec}: libavcodec/arm/c{videodsp_init_arm}: include = ($ARCH_ARM && $CONFIG_VIDEODSP)

libul{avcodec}: libavcodec/arm/c{vp3dsp_init_arm}: include = ($ARCH_ARM && $CONFIG_VP3DSP)

libul{avcodec}: libavcodec/arm/c{vp8dsp_init_arm}: include = ($ARCH_ARM && $CONFIG_VP8DSP)

# decoders/encoders
libul{avcodec}: libavcodec/arm/c{aacpsdsp_init_arm \
                                 sbrdsp_init_arm}: include = ($ARCH_ARM && $CONFIG_AAC_DECODER)

libul{avcodec}: libavcodec/arm/c{synth_filter_init_arm}: include = ($ARCH_ARM && $CONFIG_DCA_DECODER)

libul{avcodec}: libavcodec/arm/c{flacdsp_init_arm} \
                libavcodec/arm/S{flacdsp_arm}: include = ($ARCH_ARM && $CONFIG_FLAC_DECODER)

libul{avcodec}: libavcodec/arm/c{hevcdsp_init_arm}: include = ($ARCH_ARM && $CONFIG_HEVC_DECODER)

libul{avcodec}: libavcodec/arm/c{mlpdsp_init_arm}: include = ($ARCH_ARM && ($CONFIG_MLP_DECODER || $CONFIG_TRUEHD_DECODER))

libul{avcodec}: libavcodec/arm/c{rv40dsp_init_arm}: include = ($ARCH_ARM && $CONFIG_RV40_DECODER)

libul{avcodec}: libavcodec/arm/c{sbcdsp_init_arm}: include = ($ARCH_ARM && $CONFIG_SBC_ENCODER)

libul{avcodec}: libavcodec/arm/c{vorbisdsp_init_arm}: include = ($ARCH_ARM && $CONFIG_VORBIS_DECODER)

libul{avcodec}: libavcodec/arm/c{vp6dsp_init_arm}: include = ($ARCH_ARM && $CONFIG_VP6_DECODER)

libul{avcodec}: libavcodec/arm/c{vp9dsp_init_10bpp_arm \
                                 vp9dsp_init_12bpp_arm  \
                                 vp9dsp_init_arm}: include = ($ARCH_ARM && $CONFIG_VP9_DECODER)

# ARMv5TE optimizations
#
libul{avcodec}: libavcodec/arm/c{idctdsp_init_armv5te} \
                libavcodec/arm/S{simple_idct_armv5te}: include = ($ARCH_ARM && $CONFIG_IDCTDSP && $HAVE_ARMV5TE)

libul{avcodec}: libavcodec/arm/c{mpegvideo_armv5te}    \
                libavcodec/arm/S{mpegvideo_armv5te_s}: include = ($ARCH_ARM && $CONFIG_MPEGVIDEO && $HAVE_ARMV5TE)

libul{avcodec}: libavcodec/arm/c{videodsp_init_armv5te} \
                libavcodec/arm/S{videodsp_armv5te}: include = ($ARCH_ARM && $CONFIG_VIDEODSP && $HAVE_ARMV5TE)

libul{avcodec}: libavcodec/arm/S{mlpdsp_armv5te}: include = ($ARCH_ARM && ($CONFIG_MLP_DECODER || $CONFIG_TRUEHD_DECODER) && $HAVE_ARMV5TE)

# ARMv6 optimizations
#
libul{avcodec}: libavcodec/arm/S{ac3dsp_armv6}: include = ($ARCH_ARM && $CONFIG_AC3DSP && $HAVE_ARMV6)

libul{avcodec}: libavcodec/arm/c{hpeldsp_init_armv6} \
                libavcodec/arm/S{hpeldsp_armv6}: include = ($ARCH_ARM && $CONFIG_HPELDSP && $HAVE_ARMV6)

libul{avcodec}: libavcodec/arm/c{idctdsp_init_armv6} \
                libavcodec/arm/S{idctdsp_armv6        \
                                 simple_idct_armv6}: include = ($ARCH_ARM && $CONFIG_IDCTDSP && $HAVE_ARMV6)

libul{avcodec}: libavcodec/arm/S{me_cmp_armv6}: include = ($ARCH_ARM && $CONFIG_ME_CMP && $HAVE_ARMV6)

libul{avcodec}: libavcodec/arm/S{mpegaudiodsp_fixed_armv6}: include = ($ARCH_ARM && $CONFIG_MPEGAUDIODSP && $HAVE_ARMV6)

libul{avcodec}: libavcodec/arm/S{mpegvideoencdsp_armv6}: include = ($ARCH_ARM && $CONFIG_MPEGVIDEOENC && $HAVE_ARMV6)

libul{avcodec}: libavcodec/arm/S{pixblockdsp_armv6}: include = ($ARCH_ARM && $CONFIG_PIXBLOCKDSP && $HAVE_ARMV6)

libul{avcodec}: libavcodec/arm/S{startcode_armv6}: include = ($ARCH_ARM && $CONFIG_STARTCODE && $HAVE_ARMV6)

libul{avcodec}: libavcodec/arm/S{vp8_armv6        \
                                 vp8dsp_armv6}     \
                libavcodec/arm/c{vp8dsp_init_armv6}: include = ($ARCH_ARM && $CONFIG_VP8DSP && $HAVE_ARMV6)

libul{avcodec}: libavcodec/arm/S{mlpdsp_armv6}: include = ($ARCH_ARM && ($CONFIG_MLP_DECODER || $CONFIG_TRUEHD_DECODER) && $HAVE_ARMV6)

libul{avcodec}: libavcodec/arm/S{sbcdsp_armv6}: include = ($ARCH_ARM && $CONFIG_SBC_ENCODER && $HAVE_ARMV6)

# VFP optimizations
#
libul{avcodec}: libavcodec/arm/S{fmtconvert_vfp}: include = ($ARCH_ARM && $CONFIG_FMTCONVERT && $HAVE_VFP)

libul{avcodec}: libavcodec/arm/S{synth_filter_vfp}: include = ($ARCH_ARM && $CONFIG_DCA_DECODER && $HAVE_VFP)

# NEON optimizations
#
# subsystems
libul{avcodec}: libavcodec/arm/S{ac3dsp_neon}: include = ($ARCH_ARM && $CONFIG_AC3DSP && $HAVE_NEON)

libul{avcodec}: libavcodec/arm/c{audiodsp_init_neon} \
                libavcodec/arm/S{audiodsp_neon        \
                                 int_neon}: include = ($ARCH_ARM && $CONFIG_AUDIODSP && $HAVE_NEON)

libul{avcodec}: libavcodec/arm/c{blockdsp_init_neon} \
                libavcodec/arm/S{blockdsp_neon}: include = ($ARCH_ARM && $CONFIG_BLOCKDSP && $HAVE_NEON)

libul{avcodec}: libavcodec/arm/S{fmtconvert_neon}: include = ($ARCH_ARM && $CONFIG_FMTCONVERT && $HAVE_NEON)

libul{avcodec}: libavcodec/arm/S{g722dsp_neon}: include = ($ARCH_ARM && $CONFIG_G722DSP && $HAVE_NEON)

libul{avcodec}: libavcodec/arm/S{h264cmc_neon}: include = ($ARCH_ARM && $CONFIG_H264CHROMA && $HAVE_NEON)

libul{avcodec}: libavcodec/arm/S{h264dsp_neon  \
                                 h264idct_neon}: include = ($ARCH_ARM && $CONFIG_H264DSP && $HAVE_NEON)

libul{avcodec}: libavcodec/arm/S{h264pred_neon}: include = ($ARCH_ARM && $CONFIG_H264PRED && $HAVE_NEON)

libul{avcodec}: libavcodec/arm/S{h264qpel_neon}: include = ($ARCH_ARM && $CONFIG_H264QPEL && $HAVE_NEON)

# hpeldsp_neon.S is shared between CONFIG_H264QPEL and CONFIG_HPELDSP
libul{avcodec}: libavcodec/arm/S{hpeldsp_neon}: include = ($ARCH_ARM && ($CONFIG_H264QPEL || $CONFIG_HPELDSP) && $HAVE_NEON)

libul{avcodec}: libavcodec/arm/c{hpeldsp_init_neon}: include = ($ARCH_ARM && $CONFIG_HPELDSP && $HAVE_NEON)

libul{avcodec}: libavcodec/arm/c{idctdsp_init_neon} \
                libavcodec/arm/S{idctdsp_neon        \
                                 simple_idct_neon}: include = ($ARCH_ARM && $CONFIG_IDCTDSP && $HAVE_NEON)

libul{avcodec}: libavcodec/arm/S{mpegvideo_neon}: include = ($ARCH_ARM && $CONFIG_MPEGVIDEO && $HAVE_NEON)

libul{avcodec}: libavcodec/arm/S{pixblockdsp_neon}: include = ($ARCH_ARM && $CONFIG_PIXBLOCKDSP && $HAVE_NEON)

libul{avcodec}: libavcodec/arm/c{vc1dsp_init_neon} \
                libavcodec/arm/S{vc1dsp_neon}: include = ($ARCH_ARM && $CONFIG_VC1DSP && $HAVE_NEON)

libul{avcodec}: libavcodec/arm/S{vp3dsp_neon}: include = ($ARCH_ARM && $CONFIG_VP3DSP && $HAVE_NEON)

libul{avcodec}: libavcodec/arm/c{vp8dsp_init_neon} \
                libavcodec/arm/S{vp8dsp_neon}: include = ($ARCH_ARM && $CONFIG_VP8DSP && $HAVE_NEON)

# decoders/encoders
libul{avcodec}: libavcodec/arm/S{aacpsdsp_neon \
                                 sbrdsp_neon}: include = ($ARCH_ARM && $CONFIG_AAC_DECODER && $HAVE_NEON)

libul{avcodec}: libavcodec/arm/S{lossless_audiodsp_neon}: include = ($ARCH_ARM && $CONFIG_LLAUDDSP && $HAVE_NEON)

libul{avcodec}: libavcodec/arm/S{synth_filter_neon}: include = ($ARCH_ARM && $CONFIG_DCA_DECODER && $HAVE_NEON)

libul{avcodec}: libavcodec/arm/c{hevcdsp_init_neon}  \
                libavcodec/arm/S{hevcdsp_deblock_neon \
                                 hevcdsp_idct_neon    \
                                 hevcdsp_qpel_neon    \
                                 hevcdsp_sao_neon}: include = ($ARCH_ARM && $CONFIG_HEVC_DECODER && $HAVE_NEON)

# rv34dsp_neon.S is shared between CONFIG_RV30_DECODER and CONFIG_RV40_DECODER
libul{avcodec}: libavcodec/arm/S{rv34dsp_neon}: include = ($ARCH_ARM && ($CONFIG_RV30_DECODER || $CONFIG_RV40_DECODER) && $HAVE_NEON)

libul{avcodec}: libavcodec/arm/S{rv40dsp_neon}: include = ($ARCH_ARM && $CONFIG_RV40_DECODER && $HAVE_NEON)

libul{avcodec}: libavcodec/arm/S{sbcdsp_neon}: include = ($ARCH_ARM && $CONFIG_SBC_ENCODER && $HAVE_NEON)

libul{avcodec}: libavcodec/arm/S{vorbisdsp_neon}: include = ($ARCH_ARM && $CONFIG_VORBIS_DECODER && $HAVE_NEON)

libul{avcodec}: libavcodec/arm/S{vp6dsp_neon}: include = ($ARCH_ARM && $CONFIG_VP6_DECODER && $HAVE_NEON)

libul{avcodec}: libavcodec/arm/S{vp9itxfm_16bpp_neon \
                                 vp9itxfm_neon        \
                                 vp9lpf_16bpp_neon    \
                                 vp9lpf_neon          \
                                 vp9mc_16bpp_neon     \
                                 vp9mc_neon}: include = ($ARCH_ARM && $CONFIG_VP9_DECODER && $HAVE_NEON)
